{
  "name": "dx-weread",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": false
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TASKS_KV",
      "id": "082d72b578e3497ca27e6a37b8e65baf"
    }
  ],
  "routes": [
    {
      "pattern": "yangminggu.com/tasks*",
      "zone_name": "yangminggu.com"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",
      "13 0-15,23 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TASKS_STATE",
        "class_name": "TaskState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-task-state",
      "new_sqlite_classes": [
        "TaskState"
      ]
    }
  ]
}
