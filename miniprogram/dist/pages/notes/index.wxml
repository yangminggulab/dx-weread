<view class="notes-page">
  <view class="page-header"><view class="page-heading"><text class="page-title">笔记</text><text class="page-subtitle">{{subtitle}}</text></view><button class="header-add" bindtap="openAdd"><text class="header-add-icon">+</text><text>新建</text></button></view>
  <view class="search-bar"><view class="search-icon" /><input class="search-input" placeholder="搜索笔记、日记和长篇思想" placeholder-class="search-placeholder" value="{{search}}" bindinput="inputSearch" /><text wx:if="{{search}}" class="search-clear" bindtap="clearSearch">✕</text></view>
  <view wx:if="{{syncError || warning}}" class="load-warning" bindtap="refreshAll">{{syncError || warning}}</view>
  <scroll-view scroll-y="{{true}}" class="notes-list">
    <view class="notes-list-content">
    <view wx:if="{{loading}}" class="empty">加载中...</view><view wx:if="{{!loading && !sections.length}}" class="empty">{{emptyText}}</view>
    <block wx:for="{{sections}}" wx:for-item="section" wx:key="kind">
      <view wx:if="{{section.title}}" class="section-divider"><text class="section-divider-text">{{section.title}}</text></view>
      <view wx:for="{{section.items}}" wx:for-item="entry" wx:key="key" class="note-card card">
        <view class="note-header">
          <view wx:if="{{section.kind === 'diary'}}" class="note-header-date-tags"><text class="note-title">{{entry.date}}</text><view class="diary-note-tags"><text wx:for="{{entry.displayTags}}" wx:key="tag" class="note-tag diary-tag">{{item.tag}} {{item.score}}</text></view></view>
          <block wx:else><text class="note-title">{{entry.title}}</text><text class="note-date">{{section.kind === 'note' ? entry.updatedAt : entry.date}}</text></block>
        </view>
        <text wx:if="{{section.kind === 'note' ? entry.summary : entry.content}}" class="note-summary" user-select="{{true}}">{{section.kind === 'note' ? entry.summary : entry.content}}</text>
        <view wx:if="{{section.kind === 'note'}}" class="note-footer"><view class="note-tags"><text wx:for="{{entry.tags}}" wx:key="*this" class="note-tag">#{{item}}</text></view></view>
      </view>
    </block>
    <view wx:if="{{resultPages > 1}}" class="results-pager">
      <text bindtap="previousResults">{{resultPage > 0 ? '← 上一页' : ''}}</text>
      <text>{{resultPage + 1}} / {{resultPages}}</text>
      <text bindtap="nextResults">{{resultPage + 1 < resultPages ? '下一页 →' : ''}}</text>
    </view>
      </view>
  </scroll-view>
  <view wx:if="{{showAdd}}" class="modal-mask" style="bottom:{{sheetBottom || 0}}px" bindtap="dismissAdd"><scroll-view class="modal-box" scroll-y="{{true}}" scroll-into-view="{{sheetField}}" style="height:{{sheetHeight}}px" catchtap="noop"><view class="modal-content">
    <text class="modal-title">新建笔记</text>
    <view class="form-item" id="sheet-title"><text class="form-label">标题</text><view class="form-control"><input class="form-native-input" placeholder="笔记标题" value="{{form.title}}" data-field="title" bindfocus="sheetFocus" bindinput="inputForm" adjust-position="{{false}}" /></view></view>
    <view class="form-item" id="sheet-summary"><text class="form-label">内容摘要</text><view class="form-control"><textarea class="form-native-textarea form-native-summary" placeholder="简要记录内容..." value="{{form.summary}}" data-field="summary" bindfocus="sheetFocus" bindinput="inputForm" maxlength="-1" fixed="{{true}}" auto-height="{{false}}" disable-default-padding="{{true}}" adjust-position="{{false}}" /></view></view>
    <view class="form-item" id="sheet-tags"><text class="form-label">标签（逗号分隔）</text><view class="form-control"><input class="form-native-input" placeholder="如：学习, LLM, 技术" value="{{form.tags}}" data-field="tags" bindfocus="sheetFocus" bindinput="inputForm" adjust-position="{{false}}" /></view></view>
    <view class="modal-actions"><view class="btn-cancel" bindtap="dismissAdd">取消</view><view class="btn-confirm" bindtap="saveNote">保存</view></view>
  </view></scroll-view></view>
</view>
