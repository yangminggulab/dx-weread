@import "../../styles/tokens.wxss";
.versions-page { padding: 28rpx; }
.title { display: block; font-size: 36rpx; font-weight: 600; color: var(--ink); }
.description { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; color: var(--muted); }
.warning { display: block; margin-top: 16rpx; color: var(--warning); }
.version-card { margin-top: 24rpx; padding: 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx; }
.body { display: block; margin: 24rpx 0; white-space: pre-wrap; font-size: 28rpx; line-height: 1.8; color: var(--ink); }
button { font-size: 26rpx; color: var(--accent); }
