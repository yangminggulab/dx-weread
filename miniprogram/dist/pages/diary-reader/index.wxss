page { height: auto; min-height: 100%; overflow: visible; background: var(--surface); }
.reader-page { box-sizing: border-box; padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.reader-heading { padding-bottom: 32rpx; }
.reader-date { display: block; color: var(--ink); font-size: 42rpx; font-weight: 600; line-height: 1.4; }
.reader-subtitle { display: block; margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.reader-body { display: block; color: var(--ink); font-size: 32rpx; line-height: 1.9; white-space: pre-wrap; overflow-wrap: break-word; }
.reader-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 32rpx; }
.reader-tag { padding: 6rpx 12rpx; border-radius: 8rpx; background: var(--accent-soft); color: var(--accent); font-size: 22rpx; line-height: 1.5; }
.reader-count { display: block; margin-top: 32rpx; color: var(--faint); font-size: 23rpx; }
.reader-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 12rpx; border-top: 1rpx solid var(--line); }
.reader-actions button { margin: 0; padding: 0; min-height: 44px; line-height: 44px; background: transparent; color: var(--accent); font-size: 26rpx; }
.reader-actions button[disabled] { background: transparent; color: var(--faint); }
.reader-warning { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 12rpx 20rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: var(--warning-soft); color: var(--warning); font-size: 24rpx; line-height: 1.6; }
.reader-warning button { margin: 0; background: transparent; color: var(--accent); font-size: 24rpx; }
.reader-empty { padding: 80rpx 0; color: var(--muted); font-size: 28rpx; }
.reader-empty button { margin: 20rpx 0; background: transparent; color: var(--accent); font-size: 26rpx; }
@media screen and (max-width: 360px) { .reader-body { font-size: 16px; } .reader-subtitle, .reader-count, .reader-tag { font-size: 12px; } .reader-date { font-size: 22px; } .reader-actions button { font-size: 14px; } }
@media screen and (min-width: 720px) { .reader-page { max-width: 780px; margin: 0 auto; padding: 32px 28px; } .reader-date { font-size: 24px; } .reader-subtitle { font-size: 13px; } .reader-body { font-size: 18px; } .reader-heading { padding-bottom: 24px; } .reader-count, .reader-tag { font-size: 13px; } .reader-actions button { font-size: 15px; } }
