page { height: auto; min-height: 100%; overflow: visible; background: var(--bg); }
.diary-page { box-sizing: border-box; width: 100%; min-height: 100vh; background: var(--bg); }
.diary-content { box-sizing: border-box; padding: 28rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); }
.diary-load-warning { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: var(--warning-soft); color: var(--warning); font-size: 24rpx; line-height: 1.6; }
.diary-load-warning button { margin: 0; padding: 8rpx; color: var(--accent); background: transparent; font-size: 24rpx; line-height: 1.6; }
.diary-history-muted { visibility: hidden; pointer-events: none; }
.diary-history-section { margin-top: 32rpx; }
.diary-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 10rpx; }
.diary-section-title { color: var(--ink); font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.diary-all { flex-shrink: 0; margin: 0 -12rpx 0 0; padding: 0 12rpx; min-height: 44px; line-height: 44px; background: transparent; color: var(--accent); font-size: 24rpx; }
.recall-card { padding: 12rpx 28rpx 22rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--surface); }
.recall-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-caption { display: block; color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.recall-shuffle { flex-shrink: 0; margin: 0 -12rpx 0 0; padding: 0 12rpx; min-height: 44px; line-height: 44px; background: transparent; color: var(--accent); font-size: 24rpx; }
.recall-date { display: block; margin: 4rpx 0 14rpx; color: var(--ink); font-size: 27rpx; font-weight: 500; line-height: 1.5; }
.recall-excerpt { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: var(--body); font-size: 28rpx; line-height: 1.75; }
.recall-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-top: 22rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.recall-arrow { color: var(--accent); font-size: 32rpx; }
.recall-empty { padding: 32rpx 28rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--surface); color: var(--muted); font-size: 26rpx; line-height: 1.8; }
.diary-focused, .diary-focused .diary-content { background: var(--surface); }
@media screen and (max-width: 360px) { .section-caption, .diary-all, .recall-shuffle, .recall-footer { font-size: 12px; } .recall-date, .recall-excerpt { font-size: 14px; } .diary-section-title { font-size: 15px; } }
@media screen and (min-width: 720px) {
  .diary-content { max-width: 780px; margin: 0 auto; padding: 28px; }
  .diary-section-title { font-size: 16px; }
  .diary-all, .section-caption, .recall-shuffle, .recall-footer { font-size: 13px; }
  .diary-history-section { margin-top: 24px; }
  .recall-card { padding: 10px 22px 18px; border-radius: 14px; }
  .recall-date { margin: 4px 0 12px; font-size: 16px; }
  .recall-excerpt { font-size: 16px; }
  .recall-footer { padding-top: 16px; }
  .recall-empty { padding: 24px; font-size: 16px; }
}
