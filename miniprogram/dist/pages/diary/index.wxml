<view class="diary-page {{writing ? 'diary-focused' : ''}}">
  <view class="diary-content">
    <view wx:if="{{syncError || refreshFailed}}" class="diary-load-warning"><text>{{syncError || '暂时无法连接云端，当前内容已保留，会自动重试'}}</text></view>
    <diary-editor entry="{{today}}" status="{{saveStatus}}" saving="{{saving}}" conflict="{{conflict}}" automatic="{{automatic}}" bind:versions="openVersions"
      bind:edit="edit" bind:flush="flush" bind:finish="finish" bind:save="retrySave" bind:cloud="useCloud" bind:overwrite="overwrite" bind:writing="writingChanged" />
    <view hidden="{{writing}}" class="diary-history-section">
      <view class="diary-section-heading"><text class="diary-section-title">往期日记</text><button class="diary-all" bindtap="openHistory">全部 {{entryCount}} 篇 ›</button></view>
      <view wx:if="{{preview}}" class="recall-card">
        <view class="recall-heading"><text class="section-caption">{{isHistoryToday ? '历史上的今天' : '往期回顾'}}</text><button class="recall-shuffle" bindtap="recallPreview">换一篇</button></view>
        <view class="recall-entry" bindtap="openReader"><text class="recall-date">{{previewYear}} 年 {{previewDateTitle}}</text><text class="recall-excerpt">{{previewExcerpt}}</text><view class="recall-footer"><text>阅读这篇日记</text><text class="recall-arrow">›</text></view></view>
      </view>
      <view wx:elif="{{saveStatus !== 'loading' && !refreshFailed}}" class="recall-empty"><text>写下的日常，会慢慢留在这里。</text></view>
    </view>
  </view>
</view>
