@import "styles/tokens.wxss";
page { height: 100%; overflow: hidden; background: var(--bg); font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; color: var(--ink); }
button { font-family: inherit; }
button::after { border: none; }
.task-page, .books-page, .notes-page { box-sizing: border-box; display: flex; flex-direction: column; height: 100%; overflow: hidden; background: var(--bg); }
.page-header { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; flex-shrink: 0; padding: 24rpx 36rpx; }
.page-heading { flex: 1; min-width: 0; }
.page-title { display: block; font-size: 52rpx; line-height: 1.3; font-weight: 600; letter-spacing: 1rpx; color: var(--ink); }
.page-subtitle { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: var(--muted); }
.sync-warning { flex-shrink: 0; margin: 16rpx 36rpx 0; font-size: 24rpx; line-height: 1.5; color: #a35d66; }
.header-add { flex-shrink: 0; display: flex; align-items: center; gap: 8rpx; margin: 0; padding: 0 24rpx; height: 84rpx; line-height: 84rpx; border: 1rpx solid transparent; border-radius: 16rpx; background: var(--accent); color: #fff; font-size: 26rpx; font-weight: 500; }
.header-add-icon { font-size: 36rpx; line-height: 1; font-weight: 400; }
.card { box-sizing: border-box; background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; padding: 30rpx; margin-bottom: 16rpx; box-shadow: none; }
.tabs { flex-shrink: 0; display: flex; gap: 4rpx; margin: 8rpx 36rpx 0; padding: 6rpx; background: transparent; border-radius: 18rpx; }
.tab-item { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 84rpx; font-size: 26rpx; line-height: 1.5; color: var(--muted); border-radius: 14rpx; }
.tab-active { color: var(--accent); background: var(--accent-soft); font-weight: 600; box-shadow: none; }
.tab-count { font-size: 22rpx; opacity: 0.8; }
.tag { font-size: 23rpx; line-height: 1.5; color: var(--muted); }
.priority-high { color: #a35d66; }
.priority-medium, .priority-low { color: var(--muted); }
.empty { text-align: center; padding: 96rpx 20rpx; font-size: 28rpx; line-height: 1.6; color: var(--muted); }
.section-title, .section-divider-text { display: block; font-size: 24rpx; line-height: 1.5; color: var(--muted); font-weight: 500; }
.modal-mask { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(27, 42, 66, 0.28); }
.modal-box { box-sizing: border-box; width: 100%; max-height: 90%; overflow-y: auto; padding: 36rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--surface); }
.modal-title { display: block; margin-bottom: 32rpx; font-size: 36rpx; line-height: 1.4; color: var(--ink); font-weight: 600; }
.form-item { margin-bottom: 28rpx; }
.form-label { display: block; margin-bottom: 12rpx; font-size: 25rpx; line-height: 1.5; color: var(--body); }
.form-input, .form-textarea { box-sizing: border-box; width: 100%; padding: 20rpx 24rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface-soft); font-size: 30rpx; color: var(--ink); line-height: 1.6; }
input.form-input { height: 88rpx; }
.form-input-edit-tall { height: 200rpx; }
.form-textarea { height: 240rpx; }
.form-options { display: flex; gap: 12rpx; }
.option-btn { flex: 1; padding: 18rpx 0; text-align: center; border: 1rpx solid var(--line); border-radius: 14rpx; background: var(--surface-soft); color: var(--body); font-size: 26rpx; line-height: 1.5; }
.option-active { color: var(--accent); border-color: #c8d5e9; background: var(--accent-soft); font-weight: 500; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.btn-cancel, .btn-confirm { flex: 1; padding: 24rpx 0; border-radius: 18rpx; text-align: center; font-size: 30rpx; line-height: 1.5; font-weight: 500; }
.btn-cancel { color: var(--body); background: #eff2f7; }
.btn-confirm { color: #fff; background: var(--accent); }
@media screen and (max-width: 360px) { .header-add { min-height: 44px; } .tab-item { min-height: 44px; } .page-subtitle, .tag, .section-title, .section-divider-text, .tab-count { font-size: 12px; } }
@media screen and (min-width: 720px) {
  .page-header { padding: 24px 32px 20px; }
  .sync-warning { margin: 8px 32px 0; font-size: 14px; }
  .page-title { font-size: 27px; letter-spacing: 0; }
  .page-subtitle { margin-top: 8px; font-size: 14px; }
  .header-add { gap: 6px; height: 44px; padding: 0 16px; border-radius: 12px; font-size: 15px; line-height: 44px; }
  .header-add-icon { font-size: 24px; }
  .card { padding: 22px; margin-bottom: 16px; border-radius: 12px; }
  .tabs { max-width: 700px; margin: 8px 32px 0; padding: 4px; border-radius: 12px; }
  .tab-item { min-height: 42px; font-size: 15px; border-radius: 9px; }
  .tab-count { font-size: 13px; }
  .tag, .section-title, .section-divider-text { font-size: 13px; }
  .empty { padding: 64px 24px; font-size: 16px; }
  .modal-mask { align-items: center; justify-content: center; padding: 24px; }
  .modal-box { width: 560px; max-width: 100%; max-height: 90%; padding: 28px; border-radius: 20px; }
  .modal-title { margin-bottom: 24px; font-size: 24px; }
  .form-item { margin-bottom: 20px; }
  .form-label { margin-bottom: 8px; font-size: 14px; }
  .form-input, .form-textarea { padding: 12px 14px; font-size: 16px; border-radius: 10px; }
  input.form-input { height: 48px; }
  .form-input-edit-tall { height: 140px; }
  .form-textarea { height: 180px; }
  .form-options { gap: 10px; }
  .option-btn { padding: 12px 0; border-radius: 10px; font-size: 15px; }
  .modal-actions { gap: 12px; margin-top: 24px; }
  .btn-cancel, .btn-confirm { padding: 14px 0; font-size: 16px; border-radius: 12px; }
}
