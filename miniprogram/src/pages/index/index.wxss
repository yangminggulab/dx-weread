.task-list-wrap { flex: 1; min-height: 0; height: 0; }
.task-list { width: 100%; height: 100%; }
.task-list-content { box-sizing: border-box; padding: 24rpx 32rpx 36rpx; }
.task-group { border: 1rpx solid var(--line); border-radius: 20rpx; overflow: hidden; background: var(--surface); }
.task-card { display: flex; align-items: flex-start; padding: 28rpx 24rpx; border: none; border-radius: 0; box-shadow: none; margin: 0; background: transparent; }
.task-card + .task-card { border-top: 1rpx solid var(--line); }
.task-card:active { background: var(--surface-soft); }
.status-dot-wrap { flex-shrink: 0; width: 68rpx; min-height: 72rpx; margin: -10rpx 12rpx 0 -8rpx; display: flex; align-items: center; justify-content: center; }
.status-dot { width: 34rpx; height: 34rpx; border: 2rpx solid #aab9cd; border-radius: 50%; background: transparent; }
.status-dot.completed { position: relative; border-color: var(--accent); background: var(--accent); }
.status-dot.completed::after { content: ""; position: absolute; top: 8rpx; left: 6rpx; width: 14rpx; height: 8rpx; border-left: 2rpx solid #fff; border-bottom: 2rpx solid #fff; transform: rotate(-45deg); }
.task-main { flex: 1; min-width: 0; }
.task-title { display: block; font-size: 31rpx; line-height: 1.6; color: var(--ink); overflow-wrap: break-word; }
.task-meta { display: flex; flex-wrap: wrap; gap: 10rpx; align-items: center; margin-top: 12rpx; }
.meta-separator { color: #aab5c5; font-size: 22rpx; }
.done-title { color: var(--muted); text-decoration: line-through; }
.task-done { background: var(--surface-soft); box-shadow: none; }
.progress-row { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.progress-bar { flex: 1; height: 6rpx; overflow: hidden; border-radius: 4rpx; background: var(--accent-soft); }
.progress-fill { height: 100%; background: var(--accent); border-radius: 4rpx; }
.progress-text, .task-deadline { font-size: 23rpx; line-height: 1.5; color: var(--muted); }
.progress-text { white-space: nowrap; }
.task-deadline { display: block; margin-top: 14rpx; }
.section-title { padding: 20rpx 4rpx 16rpx; }
@media screen and (max-width: 360px) { .status-dot-wrap { min-width: 40px; min-height: 44px; } .task-title { font-size: 15px; } }
@media screen and (min-width: 720px) {
  .task-list-content { max-width: 1120px; margin: 0 auto; padding: 24px 32px 32px; }
  .task-group { border-radius: 12px; }
  .task-card { padding: 22px; margin: 0; }
  .status-dot-wrap { width: 40px; min-height: 44px; margin: -7px 10px 0 -8px; }
  .status-dot { width: 20px; height: 20px; border-width: 1.5px; }
  .status-dot.completed::after { top: 4px; left: 3px; width: 9px; height: 5px; border-width: 1.5px; }
  .task-title { font-size: 17px; }
  .task-meta { gap: 8px; margin-top: 10px; }
  .meta-separator { font-size: 13px; }
  .progress-row { margin-top: 12px; gap: 10px; }
  .progress-bar { height: 4px; }
  .progress-text, .task-deadline { font-size: 13px; }
  .section-title, .empty { grid-column: 1/-1; }
}
