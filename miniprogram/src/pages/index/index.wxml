<view class="task-page">
  <view class="page-header"><view class="page-heading"><text class="page-title">{{tab === 'daily' ? '日常任务' : tab === 'weekly' ? '本周任务' : '长期任务'}}</text><text class="page-subtitle">{{active.length}} 项待办 · {{completed.length}} 项已完成</text></view><button class="header-add" bindtap="openAdd"><text class="header-add-icon">+</text><text>新建</text></button></view>
  <view wx:if="{{syncError}}" class="sync-warning">{{syncError}}</view>
  <view class="tabs"><view wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab" class="tab-item {{tab === item.key ? 'tab-active' : ''}}">{{item.label}}</view></view>
  <view class="task-list-wrap">
    <scroll-view scroll-y="{{true}}" class="task-list" bindtouchstart="touchStart" bindtouchend="touchEnd">
      <view class="task-list-content">
      <view class="task-group">
      <view wx:if="{{loading && !active.length && !completed.length}}" class="empty">加载中...</view>
      <view wx:if="{{!loading && !active.length}}" class="empty">暂无待办任务</view>
      <view wx:for="{{active}}" wx:key="id" class="task-card card" data-id="{{item.id}}" bindtap="openEdit">
        <view class="status-dot-wrap" data-id="{{item.id}}" catchtap="toggleStatus"><view class="status-dot {{item.normalizedStatus}}" /></view>
        <view class="task-main"><text class="task-title">{{item.title}}</text>
        <view class="task-meta"><text class="tag {{item.priorityClass}}">{{item.priorityLabel}}优先</text><text wx:if="{{item.categoryLabel}}" class="meta-separator">·</text><text wx:if="{{item.categoryLabel}}" class="tag tag-category">{{item.categoryLabel}}</text></view>
        <view wx:if="{{item.totalPage > 0}}" class="progress-row"><view class="progress-bar"><view class="progress-fill" style="width:{{item.progress}}%" /></view><text class="progress-text">{{item.currentPage}}/{{item.totalPage}}</text></view>
        <text wx:if="{{item.deadline}}" class="task-deadline">截止：{{item.deadline}}</text>
        </view>
      </view>
      <view wx:if="{{completed.length}}" class="section-title">已完成 ({{completed.length}})</view>
      <view wx:for="{{completed}}" wx:key="id" class="task-card card task-done" data-id="{{item.id}}" bindtap="openEdit">
        <view class="status-dot-wrap" data-id="{{item.id}}" catchtap="toggleStatus"><view class="status-dot completed" /></view><view class="task-main"><text class="task-title done-title">{{item.title}}</text></view>
      </view>
      </view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{showForm}}" class="modal-mask" bindtap="noop">
    <view class="modal-box" catchtap="noop">
      <text class="modal-title">{{editID != null ? '编辑任务' : '新增任务'}}</text>
      <view class="form-item"><text class="form-label">任务名称</text><textarea class="form-input form-input-edit-tall" value="{{form.title}}" placeholder="请输入任务名称" bindinput="inputTitle" adjust-position="{{true}}" show-confirm-bar="{{true}}" fixed="{{true}}" maxlength="200" /></view>
      <view class="form-item"><text class="form-label">类型</text><view class="form-options"><view wx:for="{{typeOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="selectType" class="option-btn {{form.taskType === item.key ? 'option-active' : ''}}">{{item.label}}</view></view></view>
      <view class="form-item"><text class="form-label">优先级</text><view class="form-options"><view wx:for="{{priorityOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="selectPriority" class="option-btn {{form.priority === item.key ? 'option-active' : ''}}">{{item.label}}</view></view></view>
      <view class="modal-actions"><view class="btn-cancel" bindtap="dismissForm">取消</view><view class="btn-confirm" bindtap="saveForm">保存</view></view>
    </view>
  </view>
</view>
