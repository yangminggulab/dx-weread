.search-bar { flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; gap: 20rpx; margin: 8rpx 36rpx 24rpx; padding: 20rpx 24rpx; background: #e9eef6; border: 1rpx solid #e2e8f2; border-radius: 20rpx; }
.search-icon { position: relative; flex-shrink: 0; width: 24rpx; height: 24rpx; border: 2.5rpx solid #8191aa; border-radius: 50%; }
.search-icon::after { content: ""; position: absolute; width: 10rpx; height: 2.5rpx; right: -7rpx; bottom: -4rpx; background: #8191aa; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; border: none; background: transparent; padding: 0; font-size: 27rpx; color: var(--ink); }
.search-placeholder { color: var(--faint); }
.search-clear { padding: 0 4rpx; color: var(--muted); font-size: 28rpx; }
.load-warning { flex-shrink: 0; margin: 0 36rpx 20rpx; padding: 18rpx 24rpx; border-radius: 16rpx; color: var(--warning); background: var(--warning-soft); font-size: 24rpx; line-height: 1.6; }
.notes-list { flex: 1; min-height: 0; height: 0; width: 100%; }
.notes-list-content { box-sizing: border-box; padding: 0 32rpx 36rpx; }
.note-header { margin-bottom: 20rpx; }
.note-title { display: block; font-size: 32rpx; font-weight: 500; line-height: 1.5; color: var(--ink); overflow-wrap: break-word; }
.note-date { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; color: var(--muted); }
.note-header-date-tags { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; }
.diary-note-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.note-summary { display: block; font-size: 29rpx; line-height: 1.8; color: var(--body); white-space: pre-wrap; overflow-wrap: break-word; }
.note-footer { margin-top: 22rpx; }
.note-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.note-tag { padding: 5rpx 12rpx; border-radius: 8rpx; color: #607b9e; background: #eef3fb; font-size: 22rpx; line-height: 1.5; }
.section-divider { margin: 12rpx 4rpx 20rpx; }
.results-pager { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 4rpx; color: var(--accent); font-size: 26rpx; line-height: 1.5; }
.results-pager text { min-width: 100rpx; text-align: center; padding: 12rpx 0; }
@media screen and (max-width: 360px) { .search-input { font-size: 13px; } .note-summary { font-size: 14px; } .note-date, .note-tag { font-size: 12px; } }
@media screen and (min-width: 720px) {
  .search-bar { max-width: 736px; margin: 8px 32px 24px; padding: 14px 18px; border-radius: 12px; gap: 14px; }
  .search-icon { width: 14px; height: 14px; border-width: 1.5px; }
  .search-icon::after { width: 6px; height: 1.5px; right: -5px; bottom: -3px; }
  .search-input { font-size: 16px; }
  .search-clear { font-size: 18px; }
  .load-warning { margin: 0 32px 20px; max-width: 736px; font-size: 14px; padding: 12px 16px; }
  .notes-list-content { max-width: 800px; margin: 0 auto; padding: 0 32px 32px; }
  .note-header { margin-bottom: 16px; }
  .note-title { font-size: 19px; }
  .note-date { margin-top: 8px; font-size: 13px; }
  .note-summary { font-size: 16px; }
  .note-footer { margin-top: 16px; }
  .note-tag { padding: 4px 8px; font-size: 12px; }
  .note-tags, .diary-note-tags { gap: 6px; }
  .note-header-date-tags { gap: 10px; }
  .section-divider { margin: 12px 4px 16px; }
  .results-pager { padding: 16px 4px; font-size: 15px; }
}
