.book-list-wrap { flex: 1; min-height: 0; height: 0; }
.book-list { width: 100%; height: 100%; }
.book-list-content { box-sizing: border-box; padding: 24rpx 32rpx 36rpx; }
.book-card { margin-bottom: 20rpx; }
.book-row { display: flex; gap: 24rpx; }
.book-cover { flex-shrink: 0; width: 80rpx; height: 110rpx; border-radius: 6rpx; }
.book-cover-fallback { box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 12rpx; background: #7186a8; }
.book-cover-title { font-size: 20rpx; line-height: 1.4; color: #fff; text-align: center; }
.book-info { flex: 1; min-width: 0; }
.book-title { display: block; margin-bottom: 8rpx; font-size: 30rpx; font-weight: 600; line-height: 1.5; color: var(--ink); }
.book-author { display: block; margin-bottom: 12rpx; color: var(--body); font-size: 24rpx; line-height: 1.5; }
.book-date { display: block; margin-bottom: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.book-today-read { display: block; margin-top: 10rpx; color: var(--accent); font-size: 22rpx; line-height: 1.5; }
.progress-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.progress-bar { flex: 1; height: 8rpx; border-radius: 4rpx; background: #e8edf6; overflow: hidden; }
.progress-fill { height: 100%; background: var(--accent); border-radius: 4rpx; }
.progress-text { font-size: 22rpx; color: var(--muted); white-space: nowrap; }
.rring-card { padding: 16rpx 20rpx; margin: 0 0 8rpx; }
.rring-row { display: flex; align-items: center; width: 100%; gap: 24rpx; }
.rring-wrap { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; }
.rring-canvas { width: 272rpx; height: 272rpx; flex-shrink: 0; }
.rring-stats { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; }
.rring-stats-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 12rpx; max-width: 100%; }
.rring-stat-item { display: flex; flex-direction: column; gap: 2rpx; max-width: 100%; }
.rring-label { font-size: 22rpx; color: var(--muted); line-height: 1.5; }
.rring-val { font-size: 48rpx; font-weight: 800; color: #4cd964; line-height: 1.15; overflow-wrap: anywhere; }
.rring-val-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6rpx; }
.rring-val-streak { color: #800080; }
.rring-val-total { color: #3c71b7; }
.rring-unit { font-size: 22rpx; color: var(--muted); }
@media screen and (max-width: 360px) { .book-author, .book-date, .book-today-read, .progress-text, .rring-label, .rring-unit { font-size: 12px; } }
@media screen and (min-width: 720px) {
  .book-list-content { max-width: 1280px; margin: 0 auto; padding: 24px 24px 32px; }
  .book-card { display: inline-block; width: calc(50% - 16px); vertical-align: top; margin: 0 8px 16px; }
  .book-row { gap: 20px; }
  .book-cover { width: 62px; height: 88px; border-radius: 5px; }
  .book-cover-title { font-size: 13px; }
  .book-title { font-size: 17px; margin-bottom: 8px; }
  .book-author { font-size: 14px; margin-bottom: 10px; }
  .book-date, .progress-text { font-size: 12px; }
  .book-today-read { font-size: 13px; margin-top: 10px; }
  .progress-bar { height: 4px; }
  .rring-card { max-width: 620px; margin: 12px auto 8px; padding: 16px 20px; }
  .rring-row { gap: 24px; }
  .rring-canvas { width: 160px; height: 160px; }
  .rring-stats-inner { gap: 10px; }
  .rring-label, .rring-unit { font-size: 12px; }
  .rring-val { font-size: 26px; }

}
@media screen and (min-width: 1100px) { .book-card { width: calc(33.333333% - 16px); } }
