<view class="books-page">
  <view class="page-header"><view class="page-heading"><text class="page-title">书单</text><text class="page-subtitle">共 {{total}} 本，在读 {{counts.reading}} 本</text></view></view>
  <view wx:if="{{syncError}}" class="sync-warning">{{syncError}}</view>
  <view class="tabs"><view wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab" class="tab-item {{tab === item.key ? 'tab-active' : ''}}"><text>{{item.label}}</text><text wx:if="{{counts[item.key] > 0}}" class="tab-count">{{counts[item.key]}}</text></view></view>
  <view class="book-list-wrap">
    <scroll-view scroll-y="{{true}}" class="book-list" bindtouchstart="touchStart" bindtouchend="touchEnd">
      <view class="book-list-content">
      <view wx:if="{{loading && !books.length}}" class="empty">加载中...</view>
      <view wx:if="{{!loading && !books.length}}" class="empty">暂无书籍</view>
      <view wx:for="{{books}}" wx:key="key" class="book-card card">
        <view class="book-row">
          <image wx:if="{{item.cover}}" class="book-cover" src="{{item.cover}}" mode="aspectFill" />
          <view wx:else class="book-cover book-cover-fallback"><text class="book-cover-title">{{item.coverTitle}}</text></view>
          <view class="book-info">
            <text class="book-title">{{item.title}}</text><text wx:if="{{item.author}}" class="book-author">{{item.author}}</text><text wx:if="{{item.readAt}}" class="book-date">上次 {{item.readAt}}</text>
            <view wx:if="{{item.pct > 0}}" class="progress-row"><view class="progress-bar"><view class="progress-fill" style="width:{{item.barPct}}%" /></view><text class="progress-text">{{item.pct}}%</text></view>
            <text wx:if="{{tab === 'reading' && item.todayReadMinutes > 0}}" class="book-today-read">今天读了 {{item.todayReadMinutes}} 分钟</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!loading && tab === 'reading'}}" class="rring-card">
        <view class="rring-row">
          <view class="rring-wrap"><canvas type="2d" id="wr-ring" class="rring-canvas" /></view>
          <view class="rring-stats"><view class="rring-stats-inner">
            <view class="rring-stat-item"><text class="rring-label">今日阅读</text><text class="rring-val">{{todayText}}</text></view>
            <view class="rring-stat-item"><text class="rring-label">连续完成</text><view class="rring-val-row"><text class="rring-val rring-val-streak">{{streakDays}}</text><text class="rring-unit">天</text></view></view>
            <view class="rring-stat-item"><text class="rring-label">连续完成</text><view class="rring-val-row"><text class="rring-val rring-val-total">{{streakWeeks}}</text><text class="rring-unit">周</text></view></view>
          </view></view>
        </view>
      </view>
      </view>
    </scroll-view>
  </view>
</view>
